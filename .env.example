APP_ENV=development
APP_SECRET_KEY=replace_me
DATABASE_URL=postgresql+psycopg://gigbid:gigbid@localhost:5432/gigbid
REDIS_URL=redis://localhost:6379/0
MARKETPLACE_MODE=gigsim
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_API_TOKEN=replace_me
MODEL_PROFILE=open
OPENAI_API_KEY=
LANGSMITH_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- GigBid runtime (step 6) ----
# sqlite: local dev without the docker Postgres; auto: Postgres when DATABASE_URL is one
GIGBID_DB=sqlite
# inprocess: runs execute inside the API (local dev); worker: the API queues them for the Arq worker
GIGBID_RUNNER=inprocess
# a deployment for reviewers: no open sign-up, accounts seeded from email:password:persona
GIGBID_ALLOW_SIGNUP=true
GIGBID_SEED_USERS=
