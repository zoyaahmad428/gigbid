  "tools": {
    "create_proposal_draft": {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "input_schema": {
        "properties": {
          "bid_amount": {
            "description": "USD; hourly rate or fixed total",
            "exclusiveMinimum": 0,
            "maximum": 1000000,
            "title": "Bid Amount",
            "type": "number"
          },
          "bid_type": {
            "enum": [
              "fixed",
              "hourly"
            ],
            "title": "Bid Type",
            "type": "string"
          },
          "cover_letter": {
            "maxLength": 5000,
            "minLength": 100,
            "title": "Cover Letter",
            "type": "string"
          },
          "dry_run": {
            "default": false,
            "description": "true (default): only preview what would be sent and what it costs",
            "title": "Dry Run",
            "type": "boolean"
          },
          "idempotency_key": {
            "description": "Unique per intended action; reuse it when retrying the same action",
            "maxLength": 128,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Idempotency Key",
            "type": "string"
          },
          "job_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Job Id",
            "type": "string"
          },
          "screening_answers": {
            "default": [],
            "items": {
              "maxLength": 2000,
              "type": "string"
            },
            "maxItems": 10,
            "title": "Screening Answers",
            "type": "array"
          }
        },
        "required": [
          "job_id",
          "cover_letter",
          "bid_amount",
          "bid_type",
          "idempotency_key"
        ],
        "title": "create_proposal_draftArguments",
        "type": "object"
      },
      "output_schema": {
        "properties": {
          "action": {
            "enum": [
              "create_proposal_draft",
              "submit_proposal",
              "send_message"
            ],
            "title": "Action",
            "type": "string"
          },
          "checks": {
            "additionalProperties": true,
            "description": "Marketplace rule checks: problems, policy violations",
            "title": "Checks",
            "type": "object"
          },
          "connects_balance_after": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Connects Balance After"
          },
          "connects_cost": {
            "default": 0,
            "title": "Connects Cost",
            "type": "integer"
          },
          "dry_run": {
            "title": "Dry Run",
            "type": "boolean"
          },
          "idempotent_replay": {
            "default": false,
            "title": "Idempotent Replay",
            "type": "boolean"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Marketplace response when dry_run is false",
            "title": "Result"
          },
          "would_send": {
            "additionalProperties": true,
            "description": "Exactly what is (or would be) sent to the marketplace",
            "title": "Would Send",
            "type": "object"
          }
        },
        "required": [
          "dry_run",
          "action",
          "would_send"
        ],
        "title": "WriteResult",
        "type": "object"
      }
    },
