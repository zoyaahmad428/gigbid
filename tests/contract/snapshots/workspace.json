    "create_email_draft": {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "properties": {
          "body": {
            "maxLength": 10000,
            "minLength": 1,
            "title": "Body",
            "type": "string"
          },
          "idempotency_key": {
            "maxLength": 128,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Idempotency Key",
            "type": "string"
          },
          "subject": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Subject",
            "type": "string"
          },
          "to_label": {
            "description": "Who it is for, e.g. 'Client: Acme' (no address)",
            "maxLength": 200,
            "minLength": 1,
            "title": "To Label",
            "type": "string"
          }
        },
        "required": [
          "to_label",
          "subject",
          "body",
          "idempotency_key"
        ],
        "title": "create_email_draftArguments",
        "type": "object"
      },
      "output_schema": {
        "properties": {
          "body": {
            "title": "Body",
            "type": "string"
          },
          "draft_id": {
            "title": "Draft Id",
            "type": "string"
          },
          "idempotent_replay": {
            "default": false,
            "title": "Idempotent Replay",
            "type": "boolean"
          },
          "sent": {
            "default": false,
            "description": "Always false: this server only creates drafts",
            "title": "Sent",
            "type": "boolean"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          },
          "to_label": {
            "title": "To Label",
            "type": "string"
          }
        },
        "required": [
          "draft_id",
          "to_label",
          "subject",
          "body"
        ],
        "title": "Draft",
        "type": "object"
      }
    },
