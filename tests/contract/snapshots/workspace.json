            "type": "string"
          },
          "start": {
            "description": "ISO 8601 with offset",
            "title": "Start",
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "minLength": 3,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "start",
          "duration_minutes",
          "title",
          "idempotency_key"
        ],
        "title": "create_tentative_holdArguments",
        "type": "object"
      },
      "output_schema": {
        "properties": {
          "end": {
            "title": "End",
            "type": "string"
