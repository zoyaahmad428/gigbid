    "get_free_slots": {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "input_schema": {
        "properties": {
          "client_timezone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Client's IANA time zone, to show both",
            "title": "Client Timezone"
          },
          "days": {
            "default": 5,
            "description": "How many days ahead to look, starting tomorrow",
            "maximum": 14,
            "minimum": 1,
            "title": "Days",
            "type": "integer"
          },
          "duration_minutes": {
            "default": 30,
            "maximum": 120,
            "minimum": 15,
            "title": "Duration Minutes",
            "type": "integer"
          },
          "max_slots": {
            "default": 6,
            "maximum": 20,
            "minimum": 1,
            "title": "Max Slots",
            "type": "integer"
          },
          "start_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "YYYY-MM-DD; default is tomorrow",
            "title": "Start Date"
          },
          "timezone": {
            "default": "Asia/Karachi",
            "description": "Freelancer's IANA time zone",
            "title": "Timezone",
            "type": "string"
          }
        },
        "title": "get_free_slotsArguments",
        "type": "object"
      },
      "output_schema": {
        "$defs": {
          "Slot": {
            "properties": {
              "end": {
                "title": "End",
                "type": "string"
              },
              "start": {
                "description": "ISO 8601 with offset, in the freelancer's time zone",
                "title": "Start",
                "type": "string"
              },
              "start_client_tz": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Same start time in the client's time zone",
                "title": "Start Client Tz"
              }
            },
            "required": [
              "start",
              "end"
            ],
            "title": "Slot",
            "type": "object"
          }
        },
        "properties": {
          "client_timezone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Timezone"
          },
          "slots": {
            "items": {
              "$ref": "#/$defs/Slot"
            },
            "title": "Slots",
            "type": "array"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "timezone",
          "client_timezone",
          "slots"
        ],
        "title": "Slots",
        "type": "object"
      }
    },
